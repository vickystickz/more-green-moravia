# Docker build context is the repo root (see backend/Dockerfile).
# Send only what the backend image needs.
**

!backend
backend/.venv/
backend/.env
backend/**/__pycache__/
backend/.pytest_cache/
backend/.ruff_cache/
backend/data/*.duckdb
backend/data/*.duckdb.wal

!frontend/data/olomouc_gi_h3_r9.geojson
!frontend/data/olomouc_gi_h3_r9_metadata.json
!frontend/data/olomouc_microzones.geojson
