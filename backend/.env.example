# Which API answers: "openai" (the AI_* settings below) or "anthropic" (ANTHROPIC_*).
AI_PROVIDER=openai

# Claude API via the Anthropic SDK (AI_PROVIDER=anthropic). Only the key is required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# How hard Claude thinks: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# Any OpenAI-compatible chat-completions API (OpenRouter, Groq, DeepInfra, vLLM, Ollama...).
# The agent is off until AI_BASE_URL and AI_MODEL are set.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60

# Optional: Mapy.com API key, for street / district names of H3 hexagons.
MAPY_API_KEY=

AGENT_MAX_STEPS=6
AGENT_MAX_CONCURRENT=4

# DuckDB file built from the GeoJSON exports (python -m app.ingest)
DUCKDB_PATH=data/moravia.duckdb
INDEX_GEOJSON=data/olomouc_gi_h3_r10.geojson
INDEX_METADATA=data/olomouc_gi_h3_r10_metadata.json
MICROZONES_GEOJSON=data/olomouc_microzones.geojson

# Comma-separated origins allowed to call the API from a browser.
# An origin is scheme + host (+ port), no path: https://user.github.io
# Any localhost port is also allowed (CORS_ORIGIN_REGEX).
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
